import sys
import importlib


def check_python_version():
    """Перевіряє версію Python (потрібна >= 3.10)."""
    version = sys.version_info
    print(f"Python {version.major}.{version.minor}.{version.micro}")

    if version < (3, 10):
        print("⚠ Увага: рекомендовано Python >= 3.10")
    else:
        print("✓ Версія Python підходить")


def check_package(package_name: str) -> bool:
    try:
        module = importlib.import_module(package_name)
        version = getattr(module, '__version__', 'невідома')
        print(f"  {package_name}: {version} ✓")
        return True
    except ImportError:
        print(f"  {package_name}: НЕ ВСТАНОВЛЕНО ✗")
        return False


def main():
    check_python_version()

    print("\nВстановлені пакети:")
    packages = ['django', 'flask']
    results = {pkg: check_package(pkg) for pkg in packages}

    installed = sum(results.values())
    missing = len(packages) - installed

    print(f"\nПідсумок: встановлено {installed}, відсутні {missing}")

    if missing > 0:
        missing_pkgs = [pkg for pkg, ok in results.items() if not ok]
        print("Встановити можна командою:")
        print(f"pip install {' '.join(missing_pkgs)}")


if __name__ == "__main__":
    main()
